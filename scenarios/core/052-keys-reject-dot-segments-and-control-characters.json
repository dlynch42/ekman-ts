{
  "$schema": "../schema/scenario.schema.json",
  "id": "core/052-keys-reject-dot-segments-and-control-characters",
  "name": "a key with a directory reference, a control character, or more than 512 characters is refused",
  "level": "core",
  "given": {
    "entities": [
      {
        "name": "orders",
        "initial": "pending",
        "states": [
          {
            "state": "pending",
            "else": {
              "result": "stay"
            }
          }
        ]
      }
    ]
  },
  "when": [
    {
      "send": {
        "key": "orders:..",
        "trigger": {
          "type": "go"
        }
      }
    },
    {
      "send": {
        "key": "orders:.",
        "trigger": {
          "type": "go"
        }
      }
    },
    {
      "send": {
        "key": "orders:a\u0001b",
        "trigger": {
          "type": "go"
        }
      }
    },
    {
      "send": {
        "key": "orders:",
        "trigger": {
          "type": "go"
        }
      }
    },
    {
      "send": {
        "key": "orders:a.b",
        "trigger": {
          "type": "go"
        }
      }
    }
  ],
  "then": {
    "sends": [
      {
        "outcome": "rejected",
        "code": "INVALID_KEY"
      },
      {
        "outcome": "rejected",
        "code": "INVALID_KEY"
      },
      {
        "outcome": "rejected",
        "code": "INVALID_KEY"
      },
      {
        "outcome": "rejected",
        "code": "INVALID_KEY"
      },
      {
        "outcome": "committed"
      }
    ]
  }
}
