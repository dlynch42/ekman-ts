{
  "$schema": "../schema/scenario.schema.json",
  "id": "core/021-stay",
  "name": "a stay result updates values, advances seq, and keeps the state",
  "level": "core",
  "given": {
    "entities": [
      {
        "name": "orders",
        "initial": "pending",
        "states": [
          {
            "state": "pending",
            "else": {
              "result": "stay",
              "values": {
                "note": {
                  "$trigger": "note"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "when": [
    {
      "send": {
        "key": "orders:1",
        "trigger": {
          "type": "annotate",
          "note": "hello"
        }
      }
    }
  ],
  "then": {
    "sends": [
      {
        "outcome": "committed",
        "state": "pending",
        "seq": 1,
        "values": {
          "note": "hello"
        }
      }
    ],
    "state": {
      "orders:1": {
        "state": "pending",
        "seq": 1,
        "values": {
          "note": "hello"
        }
      }
    }
  }
}
