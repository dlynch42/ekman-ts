{
  "$schema": "../schema/scenario.schema.json",
  "id": "core/074-execution-policy-is-validated-at-construction",
  "name": "a runtime-wide execution policy no attempt could run under is refused when the runtime is built, not when the first trigger arrives",
  "level": "core",
  "given": {
    "runtime": {
      "execution": {
        "maxAttempts": 3,
        "backoff": {
          "kind": "fixed"
        }
      }
    },
    "entities": [
      {
        "name": "orders",
        "initial": "open",
        "states": [
          {
            "state": "open",
            "else": {
              "result": "stay"
            }
          }
        ]
      }
    ]
  },
  "then": {
    "buildError": {
      "code": "INVALID_CONFIG"
    }
  }
}
