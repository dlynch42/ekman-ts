{
  "$schema": "../schema/scenario.schema.json",
  "id": "core/122-transition-graph-warns",
  "name": "under warn an undeclared transition is recorded and still commits, so a real graph can be discovered from production",
  "level": "core",
  "given": {
    "entities": [
      {
        "name": "orders",
        "initial": "pending",
        "constraints": {
          "transitions": {
            "policy": "warn",
            "allow": { "pending": ["approved"] }
          }
        },
        "states": [
          {
            "state": "pending",
            "cases": [
              {
                "when": { "trigger": "ship" },
                "do": {
                  "result": "transitionTo",
                  "to": "shipped",
                  "values": { "expedited": true }
                }
              }
            ]
          },
          { "state": "approved", "else": { "result": "stay" } },
          { "state": "shipped", "else": { "result": "stay" } }
        ]
      }
    ]
  },
  "when": [{ "send": { "key": "orders:1", "trigger": { "type": "ship" } } }],
  "then": {
    "sends": [
      {
        "outcome": "committed",
        "state": "shipped",
        "seq": 1,
        "values": { "expedited": true }
      }
    ],
    "telemetry": [
      {
        "type": "constraint.violated",
        "kind": "transition",
        "policy": "warn"
      }
    ],
    "events": {
      "orders:1": [
        { "type": "transition", "from": null, "to": "pending", "seq": 0 },
        {
          "type": "violation",
          "seq": 0,
          "policy": "warn",
          "constraint": { "kind": "transition", "name": "transitions" },
          "attempted": { "from": "pending", "to": "shipped" }
        },
        { "type": "transition", "from": "pending", "to": "shipped", "seq": 1 }
      ]
    },
    "state": { "orders:1": { "state": "shipped", "seq": 1 } }
  }
}
