{
  "$schema": "../schema/scenario.schema.json",
  "id": "core/100-retry-then-succeed",
  "name": "a failed attempt is retried, and only the successful attempt commits",
  "level": "core",
  "given": {
    "runtime": {
      "execution": {
        "maxAttempts": 3,
        "backoff": {
          "kind": "fixed",
          "delayMs": 1
        }
      }
    },
    "entities": [
      {
        "name": "orders",
        "initial": "pending",
        "states": [
          {
            "state": "pending",
            "cases": [
              {
                "when": {
                  "attempt": 1
                },
                "do": {
                  "result": "fail",
                  "error": "carrier unavailable"
                }
              },
              {
                "do": {
                  "result": "transitionTo",
                  "to": "shipped",
                  "values": {
                    "attempt": {
                      "$trigger": "n"
                    }
                  }
                }
              }
            ]
          },
          {
            "state": "shipped",
            "else": {
              "result": "stay"
            }
          }
        ]
      }
    ]
  },
  "when": [
    {
      "send": {
        "key": "orders:1",
        "trigger": {
          "type": "ship",
          "n": 1
        }
      }
    }
  ],
  "then": {
    "sends": [
      {
        "outcome": "committed",
        "state": "shipped",
        "seq": 1
      }
    ],
    "telemetry": [
      {
        "type": "handler.started",
        "key": "orders:1",
        "attempt": 1
      },
      {
        "type": "handler.retried",
        "key": "orders:1",
        "attempt": 1,
        "maxAttempts": 3,
        "delayMs": 1,
        "error": "carrier unavailable"
      },
      {
        "type": "handler.settled",
        "key": "orders:1",
        "attempt": 2,
        "outcome": "committed"
      }
    ],
    "events": {
      "orders:1": [
        {
          "type": "transition",
          "from": null,
          "to": "pending",
          "seq": 0
        },
        {
          "type": "transition",
          "from": "pending",
          "to": "shipped",
          "seq": 1
        }
      ]
    },
    "state": {
      "orders:1": {
        "state": "shipped",
        "seq": 1
      }
    }
  }
}
