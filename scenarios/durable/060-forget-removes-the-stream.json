{
  "$schema": "../schema/scenario.schema.json",
  "id": "durable/060-forget-removes-the-stream",
  "name": "forgetting an instance removes its state and its whole stream, not only what is resident",
  "level": "durable",
  "given": {
    "runtime": { "store": [{ "kind": "file" }] },
    "entities": [
      {
        "name": "deployments",
        "initial": "pending",
        "states": [
          {
            "state": "pending",
            "cases": [
              {
                "when": { "trigger": "start" },
                "do": {
                  "result": "transitionTo",
                  "to": "deploying",
                  "values": { "region": { "$trigger": "region" } }
                }
              }
            ]
          },
          {
            "state": "deploying",
            "cases": [
              {
                "when": { "trigger": "finish" },
                "do": { "result": "transitionTo", "to": "live" }
              }
            ]
          },
          { "state": "live", "else": { "result": "stay" } }
        ]
      }
    ]
  },
  "when": [
    {
      "send": {
        "key": "deployments:abc123",
        "trigger": { "type": "start", "region": "us-west-2" }
      }
    },
    {
      "send": { "key": "deployments:abc123", "trigger": { "type": "finish" } }
    },
    { "forget": { "key": "deployments:abc123" } }
  ],
  "then": {
    "sends": [
      { "outcome": "committed", "state": "deploying", "seq": 1 },
      { "outcome": "committed", "state": "live", "seq": 2 }
    ],
    "forgets": [{ "outcome": "ok" }],
    "state": { "deployments:abc123": null },
    "resident": [],
    "history": { "deployments:abc123": { "events": [] } }
  }
}
