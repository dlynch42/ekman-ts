{
  "$schema": "../schema/scenario.schema.json",
  "id": "durable/064-forgotten-stays-forgotten",
  "name": "an instance forgotten before a restart does not come back with the ones that survived it",
  "level": "durable",
  "given": {
    "runtime": { "store": [{ "kind": "file" }] },
    "entities": [
      {
        "name": "deployments",
        "initial": "pending",
        "states": [
          {
            "state": "pending",
            "cases": [
              {
                "when": { "trigger": "start" },
                "do": {
                  "result": "transitionTo",
                  "to": "deploying",
                  "values": { "region": { "$trigger": "region" } }
                }
              }
            ]
          },
          { "state": "deploying", "else": { "result": "stay" } }
        ]
      }
    ]
  },
  "when": [
    {
      "send": {
        "key": "deployments:gone",
        "trigger": { "type": "start", "region": "us-west-2" }
      }
    },
    {
      "send": {
        "key": "deployments:kept",
        "trigger": { "type": "start", "region": "eu-west-1" }
      }
    },
    { "forget": { "key": "deployments:gone" } },
    { "restart": true }
  ],
  "then": {
    "forgets": [{ "outcome": "ok" }],
    "state": {
      "deployments:gone": null,
      "deployments:kept": null
    },
    "queries": [
      {
        "entity": "deployments",
        "state": "deploying",
        "keys": ["deployments:kept"],
        "complete": true
      }
    ],
    "history": {
      "deployments:gone": { "events": [] },
      "deployments:kept": { "events": ["transition@0", "transition@1"] }
    }
  }
}
