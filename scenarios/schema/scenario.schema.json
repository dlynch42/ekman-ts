{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekman.dev/schema/scenario.schema.json",
  "title": "Ekman conformance scenario",
  "description": "One conformance scenario. See scenarios/README.md for prose documentation.",
  "type": "object",
  "required": ["id", "name", "level", "given"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^(core|durable|coordinated)/[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": ["core", "durable", "coordinated"]
    },
    "given": {
      "$ref": "#/$defs/given"
    },
    "when": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "then": {
      "$ref": "#/$defs/then"
    }
  },
  "$defs": {
    "given": {
      "type": "object",
      "required": ["entities"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clock": {
              "type": "object",
              "required": ["start", "stepMs"],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "stepMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "coordination": {
              "description": "How many runtimes write these keys. multi is refused unless the commit authority declares its conditional append holds across processes.",
              "enum": ["single", "multi"]
            },
            "inbox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "capacity": {
                  "description": "How many triggers may wait per key. A queue length in triggers, never a size in bytes. The one being handled has already left the queue and does not count against it.",
                  "type": "integer",
                  "minimum": 0
                },
                "overflow": {
                  "enum": ["reject", "drop-newest", "drop-oldest"]
                },
                "recordOverflow": {
                  "type": "boolean"
                }
              }
            },
            "execution": {
              "description": "Default execution policy for every handler in the runtime.",
              "$ref": "#/$defs/policy"
            },
            "temporal": {
              "description": "How temporal constraints are evaluated. Scenarios normally drive them with an explicit sweep step instead.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sweepMs": {
                  "description": "Milliseconds between automatic sweeps. Omitted means sweeps happen only when asked for.",
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "store": {
              "description": "Where commits go. Omitted means memory only. A list is a layered stack, read fastest first, with exactly one commit authority.",
              "oneOf": [
                { "$ref": "#/$defs/storeLayer" },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/storeLayer" }
                }
              ]
            },
            "memory": {
              "description": "The resident budget. Accounting is UTF-8 bytes of key + state + serialized values, measured at commit.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxBytes": {
                  "description": "Omitted means unlimited. 0 means no residency at all, and requires a store.",
                  "type": "integer",
                  "minimum": 0
                },
                "eviction": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "policy": {
                      "description": "lru releases idle instances, reject refuses new ones, none only reports.",
                      "enum": ["lru", "reject", "none"]
                    },
                    "snapshotOnEvict": {
                      "description": "Persist before releasing. Defaults to on when a store is configured, and is refused without one.",
                      "type": "boolean"
                    },
                    "allowDiscard": {
                      "description": "Permit eviction to throw state away when there is no store to put it in.",
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "audit": {
              "description": "Sinks receiving copies of committed events. A sink can never veto or delay a commit.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "failTimes": {
                    "description": "Reject this many deliveries before succeeding, exercising at-least-once retrying.",
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name", "initial", "states"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^:\\s]+$"
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object"
        },
        "unknown": {
          "enum": ["reject"]
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "description": "Entity-wide policy, over the runtime's and under any state's.",
          "$ref": "#/$defs/policy"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateSpec"
          }
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "onError": {
          "description": "Recovery handlers keyed by error classification, with * as the fallback.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/do"
          }
        }
      }
    },
    "storeLayer": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "memory is ephemeral, file is durable. Runners own the storage a file layer uses.",
          "enum": ["memory", "file"]
        },
        "name": {
          "description": "Layer name, used in telemetry. Defaults to the kind. Layers must not share one.",
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "description": "Claim to be the commit authority, overriding the runtime's own choice.",
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "description": "The strictness dial. Every constraint is opt-in and carries its own violation policy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transitions": {
          "description": "Which transitions are legal. Every transitionTo is checked, including one targeting the current state.",
          "type": "object",
          "required": ["allow"],
          "additionalProperties": false,
          "properties": {
            "policy": { "$ref": "#/$defs/violationPolicy" },
            "allow": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "guards": {
          "description": "Entry conditions on a target state, checked before committing a move into it.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on", "check"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "on": { "type": "string", "minLength": 1 },
              "from": {
                "description": "Source states this guard is scoped to. Omitted means any of them.",
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "policy": { "$ref": "#/$defs/violationPolicy" },
              "check": { "$ref": "#/$defs/check" }
            }
          }
        },
        "invariants": {
          "description": "Conditions that must hold in a state, checked before any result that changes values.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "in": {
                "description": "States this applies to. Omitted means every state.",
                "type": "array",
                "items": { "type": "string" }
              },
              "policy": { "$ref": "#/$defs/violationPolicy" },
              "check": { "$ref": "#/$defs/check" }
            }
          }
        },
        "temporal": {
          "description": "Bounds on how long an instance may sit in one state. Evaluated by a sweep, and firing delivers a trigger.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["in", "within"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "in": { "type": "string", "minLength": 1 },
              "within": {
                "description": "Milliseconds an instance may remain in the state.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "escalateTo": {
                "description": "Carried on the escalation trigger for the handler to act on. The runtime never applies it directly.",
                "type": "string"
              },
              "trigger": {
                "description": "Type of the delivered trigger. Defaults to constraint.temporal.",
                "type": "string"
              },
              "policy": { "$ref": "#/$defs/violationPolicy" }
            }
          }
        }
      }
    },
    "violationPolicy": {
      "description": "reject refuses the result, warn records it and proceeds, off is not evaluated. Defaults to reject.",
      "enum": ["reject", "warn", "off"]
    },
    "check": {
      "description": "A guard or invariant condition as data: one source, one predicate.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "description": "Dot path into the values being proposed. Empty string is the whole map.",
          "type": "string"
        },
        "trigger": {
          "description": "Dot path into the trigger.",
          "type": "string"
        },
        "state": {
          "description": "Read the proposed state name.",
          "const": true
        },
        "exists": { "type": "boolean" },
        "equals": {},
        "gte": { "type": "number" },
        "lte": { "type": "number" },
        "reason": {
          "description": "Reported as the violation's reason when the check does not hold.",
          "type": "string"
        },
        "throw": {
          "description": "Throw instead of answering, exercising the broken-check path.",
          "type": "string"
        }
      }
    },
    "stateSpec": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["do"],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "trigger": {
                    "type": "string"
                  },
                  "attempt": {
                    "description": "Matches the 1-based attempt number, so a case can fail once then commit.",
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "do": {
                "$ref": "#/$defs/do"
              }
            }
          }
        },
        "else": {
          "$ref": "#/$defs/do"
        },
        "policy": {
          "description": "Policy for this state alone, over the entity's and the runtime's.",
          "$ref": "#/$defs/policy"
        }
      }
    },
    "do": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": ["transitionTo", "stay", "fail"]
        },
        "to": {
          "description": "A state name, or a value expression resolving to one. An escalation carries its target on the trigger."
        },
        "values": {},
        "error": {
          "type": "string"
        },
        "errorName": {
          "type": "string"
        },
        "throw": {
          "type": "string"
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": ["result"]
        },
        {
          "required": ["throw"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "transitionTo"
              }
            },
            "required": ["result"]
          },
          "then": {
            "required": ["to"]
          }
        },
        {
          "if": {
            "required": ["to"]
          },
          "then": {
            "properties": {
              "result": {
                "const": "transitionTo"
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "send": {
          "type": "object",
          "required": ["key", "trigger"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "trigger": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "await": {
          "type": "boolean"
        },
        "drain": {
          "const": true
        },
        "wait": {
          "description": "Pause this many milliseconds, for work still in flight after every send has settled.",
          "type": "integer",
          "minimum": 0
        },
        "advance": {
          "description": "Move the declared clock forward this many milliseconds. Ages an instance past a temporal bound without waiting for real time.",
          "type": "integer",
          "minimum": 0
        },
        "sweep": {
          "description": "Evaluate temporal constraints once and settle whatever they escalate.",
          "const": true
        },
        "restart": {
          "description": "Throw the runtime away and build a new one against the same storage. Resident state is lost; durable state is not.",
          "const": true
        },
        "forget": {
          "description": "Delete an instance outright: its resident state and its stream in every layer. Destroys committed state, so it is addressed by key and never inferred.",
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            }
          }
        }
      },
      "oneOf": [
        { "required": ["send"] },
        { "required": ["drain"] },
        { "required": ["wait"] },
        { "required": ["advance"] },
        { "required": ["sweep"] },
        { "required": ["restart"] },
        { "required": ["forget"] }
      ]
    },
    "then": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outcome"],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "enum": ["committed", "rejected"]
              },
              "state": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "values": {
                "type": "object"
              },
              "code": {
                "$ref": "#/$defs/errorCode"
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": ["transition", "rejected", "violation", "restored"]
                },
                "from": {
                  "type": ["string", "null"]
                },
                "to": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                },
                "at": {
                  "type": "integer"
                },
                "cause": {
                  "type": "object"
                },
                "values": {
                  "type": "object"
                },
                "code": {
                  "$ref": "#/$defs/errorCode"
                },
                "reason": {
                  "type": "string"
                },
                "constraint": {
                  "description": "Present on a violation event.",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": ["transition", "guard", "invariant", "temporal"]
                    },
                    "name": { "type": "string" }
                  }
                },
                "policy": {
                  "description": "Present on a violation event. warn means the commit went ahead anyway.",
                  "enum": ["reject", "warn"]
                },
                "attempted": {
                  "description": "The change a violation was refusing. Absent on a temporal violation, which is attached to no result.",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" }
                  }
                },
                "replayed": {
                  "description": "Present on a restored event: how many events were read on top of any snapshot.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "telemetry": {
          "description": "Telemetry matchers, asserted as an ordered subsequence of what was emitted rather than an exact list.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "inbox.enqueued",
                  "inbox.rejected",
                  "inbox.dropped",
                  "handler.started",
                  "handler.settled",
                  "handler.retried",
                  "handler.timedOut",
                  "commit.fenced",
                  "constraint.violated",
                  "constraint.escalated",
                  "commit.raced",
                  "memory.accounted",
                  "memory.refused",
                  "instance.evicted",
                  "instance.restored",
                  "audit.failed",
                  "store.cacheFailed"
                ]
              }
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string"
              },
              "values": {
                "type": "object"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "resident": {
          "description": "Keys still in memory, in any order. Paired with then.state, this is how a transparent reload is proved.",
          "type": "array",
          "items": { "type": "string" }
        },
        "forgets": {
          "description": "Outcomes of the forget steps, in the order the steps appear.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outcome"],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "enum": ["ok", "refused"]
              },
              "code": {
                "description": "The stable error code, asserted on refused.",
                "$ref": "#/$defs/errorCode"
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instances": {
              "description": "Exact number of resident instances.",
              "type": "integer",
              "minimum": 0
            },
            "withinBytes": {
              "description": "Upper bound on resident accounting. Not an exact figure, because it depends on key names.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "audit": {
          "description": "Events each sink received, by sink name, as <type>@<seq>.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "queries": {
          "description": "Queries run after everything settles, each with the answer it must give.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "keys"],
            "additionalProperties": false,
            "properties": {
              "entity": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 },
              "olderThan": {
                "description": "Milliseconds, or a duration such as 5m. Inclusive at the bound.",
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d)$"
                  }
                ]
              },
              "limit": { "type": "integer", "minimum": 0 },
              "keys": {
                "description": "Matching keys, oldest in state first, ties broken on the key.",
                "type": "array",
                "items": { "type": "string" }
              },
              "complete": { "type": "boolean" },
              "reasons": {
                "description": "Asserted as a set.",
                "type": "array",
                "items": { "$ref": "#/$defs/partiality" }
              }
            }
          }
        },
        "history": {
          "description": "Per-key history reads, for what then.events cannot say.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "events": {
                "description": "The stream as <type>@<seq>, in order.",
                "type": "array",
                "items": { "type": "string" }
              },
              "complete": { "type": "boolean" },
              "reasons": {
                "type": "array",
                "items": { "$ref": "#/$defs/partiality" }
              }
            }
          }
        },
        "buildError": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/errorCode"
            }
          }
        }
      }
    },
    "partiality": {
      "description": "Why an answer is not the whole answer. A result is complete exactly when there are none.",
      "enum": ["no-durable-store", "unsupported-criteria", "limit-reached"]
    },
    "errorCode": {
      "enum": [
        "INVALID_KEY",
        "UNKNOWN_ENTITY",
        "UNKNOWN_STATE",
        "UNKNOWN_TRIGGER",
        "HANDLER_FAILED",
        "INBOX_OVERFLOW",
        "TRIGGER_DROPPED",
        "HANDLER_TIMEOUT",
        "COMMIT_FENCED",
        "CONSTRAINT_VIOLATED",
        "STORE_CONFLICT",
        "STORE_UNAVAILABLE",
        "STORE_FULL",
        "MEMORY_EXHAUSTED",
        "KEY_BUSY",
        "DUPLICATE_ENTITY",
        "DUPLICATE_STATE_HANDLER",
        "MISSING_INITIAL_STATE",
        "INITIAL_STATE_NOT_IN_STATES",
        "INVALID_CONFIG",
        "NOT_IMPLEMENTED"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "description": "Total attempts including the first. 1 means no retries.",
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "description": "How long one attempt may take. Omit for no timeout.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "backoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["fixed", "exponential"]
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "baseMs": {
              "type": "integer",
              "minimum": 0
            },
            "factor": {
              "type": "number",
              "minimum": 1
            },
            "maxDelayMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["kind"]
        }
      }
    }
  }
}
