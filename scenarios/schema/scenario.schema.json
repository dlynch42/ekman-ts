{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekman.dev/schema/scenario.schema.json",
  "title": "Ekman conformance scenario",
  "description": "One conformance scenario. See scenarios/README.md for prose documentation.",
  "type": "object",
  "required": ["id", "name", "level", "given"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^(core|durable|coordinated)/[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": ["core", "durable", "coordinated"]
    },
    "given": {
      "$ref": "#/$defs/given"
    },
    "when": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "then": {
      "$ref": "#/$defs/then"
    }
  },
  "$defs": {
    "given": {
      "type": "object",
      "required": ["entities"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clock": {
              "type": "object",
              "required": ["start", "stepMs"],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "stepMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "inbox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "capacity": {
                  "description": "How many triggers may wait per key. A queue length in triggers, never a size in bytes. The one being handled has already left the queue and does not count against it.",
                  "type": "integer",
                  "minimum": 0
                },
                "overflow": {
                  "enum": ["reject", "drop-newest", "drop-oldest"]
                },
                "recordOverflow": {
                  "type": "boolean"
                }
              }
            },
            "execution": {
              "description": "Default execution policy for every handler in the runtime.",
              "$ref": "#/$defs/policy"
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name", "initial", "states"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^:\\s]+$"
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object"
        },
        "unknown": {
          "enum": ["reject"]
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "description": "Entity-wide policy, over the runtime's and under any state's.",
          "$ref": "#/$defs/policy"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateSpec"
          }
        }
      }
    },
    "stateSpec": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["do"],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "trigger": {
                    "type": "string"
                  },
                  "attempt": {
                    "description": "Matches the 1-based attempt number, so a case can fail once then commit.",
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "do": {
                "$ref": "#/$defs/do"
              }
            }
          }
        },
        "else": {
          "$ref": "#/$defs/do"
        },
        "policy": {
          "description": "Policy for this state alone, over the entity's and the runtime's.",
          "$ref": "#/$defs/policy"
        }
      }
    },
    "do": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": ["transitionTo", "stay", "fail"]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "values": {},
        "error": {
          "type": "string"
        },
        "errorName": {
          "type": "string"
        },
        "throw": {
          "type": "string"
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": ["result"]
        },
        {
          "required": ["throw"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "transitionTo"
              }
            },
            "required": ["result"]
          },
          "then": {
            "required": ["to"]
          }
        },
        {
          "if": {
            "required": ["to"]
          },
          "then": {
            "properties": {
              "result": {
                "const": "transitionTo"
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "send": {
          "type": "object",
          "required": ["key", "trigger"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "trigger": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "await": {
          "type": "boolean"
        },
        "drain": {
          "const": true
        },
        "wait": {
          "description": "Pause this many milliseconds, for work still in flight after every send has settled.",
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": ["send"]
        },
        {
          "required": ["drain"]
        }
      ]
    },
    "then": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outcome"],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "enum": ["committed", "rejected"]
              },
              "state": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "values": {
                "type": "object"
              },
              "code": {
                "$ref": "#/$defs/errorCode"
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": ["transition", "rejected", "violation", "restore"]
                },
                "from": {
                  "type": ["string", "null"]
                },
                "to": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                },
                "at": {
                  "type": "integer"
                },
                "cause": {
                  "type": "object"
                },
                "values": {
                  "type": "object"
                }
              }
            }
          }
        },
        "telemetry": {
          "description": "Telemetry matchers, asserted as an ordered subsequence of what was emitted rather than an exact list.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "inbox.enqueued",
                  "inbox.rejected",
                  "inbox.dropped",
                  "handler.started",
                  "handler.settled",
                  "handler.retried",
                  "handler.timedOut",
                  "commit.fenced"
                ]
              }
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string"
              },
              "values": {
                "type": "object"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "buildError": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/errorCode"
            }
          }
        }
      }
    },
    "errorCode": {
      "enum": [
        "INVALID_KEY",
        "UNKNOWN_ENTITY",
        "UNKNOWN_STATE",
        "UNKNOWN_TRIGGER",
        "HANDLER_FAILED",
        "INBOX_OVERFLOW",
        "TRIGGER_DROPPED",
        "HANDLER_TIMEOUT",
        "COMMIT_FENCED",
        "DUPLICATE_ENTITY",
        "DUPLICATE_STATE_HANDLER",
        "MISSING_INITIAL_STATE",
        "INITIAL_STATE_NOT_IN_STATES",
        "INVALID_CONFIG",
        "NOT_IMPLEMENTED"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "description": "Total attempts including the first. 1 means no retries.",
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "description": "How long one attempt may take. Omit for no timeout.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "backoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["fixed", "exponential"]
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "baseMs": {
              "type": "integer",
              "minimum": 0
            },
            "factor": {
              "type": "number",
              "minimum": 1
            },
            "maxDelayMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["kind"]
        }
      }
    }
  }
}
